# Copy this file to .env and fill it in. Never commit .env.

# --- Twilio (Console > Account > API keys & tokens) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# The one Twilio number used for everything: resident calls and technician calls. E.164.
TWILIO_PHONE_NUMBER=+15551230000

# --- ElevenLabs ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Transfer ---
# Technicians to call, comma-separated E.164. In sequential mode they are tried in this order.
TECH_NUMBERS=+15551110001,+15551110002
# sequential (default): one technician at a time. parallel: ring all at once, first to press 1 wins.
DIAL_MODE=sequential

# --- Server ---
# Public https URL that reaches this server (your ngrok URL). No trailing slash, no path.
# Twilio signatures are validated against this URL, so it must match what Twilio calls exactly.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app
# Only for "npm run tunnel", which starts ngrok and fills in PUBLIC_BASE_URL for you.
# Token: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Shared secret for non-Twilio callers: the ElevenLabs request_transfer tool and /start-call
# must send it in the X-Tool-Secret header. Use a long random string, for example the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOOL_SECRET=change_me_to_a_long_random_string

# TwiML App through which Ava joins the call (branch agent-stays-on-call).
# Leave empty and run: node scripts/setup-agent-app.js   (it creates the app and fills this in)
TWILIO_AGENT_APP_SID=

# --- Incoming calls (branch inbound-calls) ---
# Only these phones reach Ava when they call the Twilio number (comma-separated E.164).
# Leave empty to let anyone who calls the number reach Ava.
INBOUND_ALLOWED_CALLERS=
# Where callers who are NOT on the list are sent: the app the number pointed at before.
# Filled in by: node scripts/setup-inbound-number.js   (empty = those callers are rejected)
INBOUND_PASS_THROUGH_URL=

# --- Optional (defaults shown) ---
# PORT=3000
# RING_TIMEOUT_SEC=20
# Hold music for the resident while technicians are called. It starts this many seconds after
# Ava asks for a technician, so she can finish saying "please hold". Use "off" for no hold music.
# HOLD_MUSIC_DELAY_SEC=5
# Music to play: a Twilio hold-music URL, or a direct link to an .mp3 or .wav file.
# HOLD_MUSIC_URL=http://twimlets.com/holdmusic?Bucket=com.twilio.music.classical
# Only if your ElevenLabs workspace uses a data-residency host, e.g. https://api.eu.residency.elevenlabs.io
# ELEVENLABS_API_BASE=https://api.elevenlabs.io
